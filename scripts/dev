#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$PWD/target}"
if [ "$#" -eq 0 ]; then set -- bash; fi
runner="${CADENCE_NIX:-nix}"
if ! command -v "$runner" >/dev/null; then
  printf 'Nix was not found. Install Nix, or set CADENCE_NIX to a Nix executable/wrapper.\n' >&2
  exit 127
fi
exec "$runner" --extra-experimental-features 'nix-command flakes' develop --accept-flake-config --no-write-lock-file -c "$@"
